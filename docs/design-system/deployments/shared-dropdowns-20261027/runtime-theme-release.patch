+import Component from "@glimmer/component";
+import { hash } from "@ember/helper";
+import { action } from "@ember/object";
+import { themePrefix } from "virtual:theme";
+import ComboBox from "discourse/select-kit/components/combo-box";
+import { selectKitOptions } from "discourse/select-kit/components/select-kit";
+import dUniqueId from "discourse/ui-kit/helpers/d-unique-id";
+import { i18n } from "discourse-i18n";
+
+@selectKitOptions({ headerAriaLabel: null })
+class AlumniLocationComboBox extends ComboBox {
+  onOpen() {
+    this.onPickerOpen?.(this.selectKit);
+  }
+
+  updateFloatingUiPosition() {
+    return super.updateFloatingUiPosition().then(() => {
+      const body = this.selectKit.bodyElement();
+      const header = this.selectKit.headerElement();
+      if (!body?.isConnected || !header) {
+        return;
+      }
+
+      const reference = header.getBoundingClientRect();
+      if (window.innerWidth <= 450) {
+        // SelectKit's full-viewport mobile menu is clipped by the task dialog.
+        body.style.minWidth = "0";
+        body.style.width = `${reference.width}px`;
+        body.style.left = `${reference.left - body.getBoundingClientRect().left}px`;
+      }
+
+      const container = body.closest(".d-modal__body");
+      if (container) {
+        const bounds = container.getBoundingClientRect();
+        const offset = this.selectKit.options.verticalOffset;
+        const available = this.selectKit.isPlacedAbove
+          ? reference.top - Math.max(0, bounds.top) - offset
+          : Math.min(window.innerHeight, bounds.bottom) -
+            reference.bottom -
+            offset;
+        body.style.maxHeight = `${Math.max(0, available)}px`;
+        if (this.selectKit.isPlacedAbove) {
+          body.style.top = `${reference.top - offset - body.getBoundingClientRect().bottom}px`;
+        }
+      }
+    });
+  }
+}
+
+export default class ISBFAlumniLocationPicker extends Component {
+  #id = dUniqueId();
+
+  get ariaLabel() {
+    const selected = this.args.items.find(
+      (item) => item.code === this.args.value
+    );
+    const value = selected?.name || this.args.noneLabel;
+    return value
+      ? i18n(themePrefix("isbf_v2.alumni_location_value"), {
+          label: this.args.label,
+          value,
+        })
+      : this.args.label;
+  }
+
+  get pickerId() {
+    return this.args.id ?? this.#id;
+  }
+
+  @action
+  select(value) {
+    const code = value ?? "";
+    if (!this.args.disabled && code !== this.args.value) {
+      return this.args.onChange(code);
+    }
+  }
+
+  <template>
+    <AlumniLocationComboBox
+      class="isbf-alumni-location-picker"
+      inert={{@disabled}}
+      ...attributes
+      @content={{@items}}
+      @id={{this.pickerId}}
+      @nameProperty="name"
+      @onChange={{this.select}}
+      @onPickerOpen={{@onOpen}}
+      @options={{hash
+        autoInsertNoneItem=@allowNone
+        clearable=false
+        disabled=@disabled
+        filterable=true
+        headerAriaLabel=this.ariaLabel
+        translatedNone=@noneLabel
+        triggerOnChangeOnTab=false
+      }}
+      @value={{@value}}
+      @valueProperty="code"
+    />
+  </template>
+}
