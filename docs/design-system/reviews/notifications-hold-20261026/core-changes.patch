+              {{#if (has-block)}}{{yield}}{{else}}{{i18n @label}}{{/if}}
+            </Labels>
+          </span>
+        </span>
+      </span>
+      <span class="sr-only" id={{this.hintId}}>{{i18n @hint}}</span>
+    </DButton>
+  </template>
+}
