+      } else if (target === 1) {
+        this.#complete();
+      }
+    };
+    this.#frame = requestAnimationFrame(step);
+  }
+
+  <template>
+    {{! eslint-disable ember/template-no-pointer-down-event-binding -- Timed confirmation begins when the press starts. }}
