+.d-hold-button {
+  --d-hold-radius: var(--d-button-border-radius);
+  --d-hold-background: var(--primary-very-low);
+  --d-hold-fill: var(--tertiary);
+  --d-hold-text: var(--primary);
+  --d-hold-fill-text: var(--secondary);
+  --d-hold-time: 2000ms;
+  --d-hold-release: 200ms;
+  --d-hold-wave: 6px;
+  --d-hold-width: 0px;
+  --d-hold-height: 0px;
+  --d-hold-progress: 0;
+  --d-hold-cycles: 2;
