+.isbf-v2-appearance-modal {
+  @media (width >= 601px) {
+    align-items: center;
+    left: var(--isbf-v2-feed-left);
+    width: var(--isbf-v2-feed-width);
+
+    .d-modal__container {
+      position: relative;
+      width: 100%;
+      min-width: 0;
+      max-width: 100%;
+      margin: 0;
+    }
+  }
+}
+
+.isbf-v2-appearance-modal__options {
+  display: grid;
+  gap: var(--isbf-v2-space-2);
+}
+
+.isbf-v2-appearance-modal__option {
+  display: grid;
+  grid-template-columns: 16px minmax(0, 1fr) 16px;
+  justify-content: stretch;
+  box-sizing: border-box;
+  align-items: center;
+  gap: var(--isbf-v2-space-3);
+  width: 100%;
+  height: 48px;
+  min-height: 48px;
+  padding: var(--isbf-v2-space-2) var(--isbf-v2-space-3);
+  border-radius: var(--isbf-v2-radius-sm);
+  background: transparent;
+  color: var(--isbf-v2-text);
+  font-size: var(--isbf-v2-font-sm);
+  text-align: left;
+
+  .d-icon {
+    width: 16px;
+    height: 16px;
+    margin: 0;
+    color: inherit;
+  }
+
+  > span {
+    min-width: 0;
+  }
+
+  .isbf-v2-appearance-modal__selected {
+    display: grid;
+    place-items: center;
+    width: 16px;
+    height: 16px;
+  }
+
+  &[aria-pressed="true"],
+  &:hover,
+  &:focus-visible {
+    background: var(--isbf-v2-hover);
+    color: var(--isbf-v2-text);
+  }
+
+  &:focus-visible {
+    outline: 3px solid var(--isbf-v2-focus-ring);
+    outline-offset: -3px;
   }
 }
 
